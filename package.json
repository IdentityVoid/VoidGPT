{
  "name": "void-coder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "typecheck:web": "tsc -b --noEmit",
    "typecheck:cli": "tsc -p tsconfig.cli.json --noEmit",
    "setup": "node scripts/setup.mjs",
    "setup:linux": "bash scripts/install.sh",
    "setup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "dev:linux": "bash scripts/dev.sh",
    "dev:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "cli:dev": "bun cli/index.ts",
    "build:cli": "bun build --compile cli/index.ts --outfile bin/voidcoder --target bun-$(uname 2>/dev/null | tr '[:upper:]' '[:lower:]')-$(uname -m 2>/dev/null | sed 's/x86_64/x64/;s/aarch64/arm64/')",
    "build:cli:linux": "bun build --compile cli/index.ts --outfile dist/voidcoder-linux-x64 --target bun-linux-x64",
    "build:cli:linux-arm": "bun build --compile cli/index.ts --outfile dist/voidcoder-linux-arm64 --target bun-linux-arm64",
    "build:cli:macos": "bun build --compile cli/index.ts --outfile dist/voidcoder-darwin-x64 --target bun-darwin-x64",
    "build:cli:macos-arm": "bun build --compile cli/index.ts --outfile dist/voidcoder-darwin-arm64 --target bun-darwin-arm64",
    "build:cli:windows": "bun build --compile cli/index.ts --outfile dist/voidcoder.exe --target bun-windows-x64",
    "cli:install": "node scripts/install-cli.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "convex": "^1.17.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
