# OpenRouter API key (optional; without it the app still works but is rate-limited by OpenRouter's free tier caps)
OPENROUTER_API_KEY=

# Model name. Default is a free-tier 70B. Override with any OpenRouter model id, e.g.:
#   qwen/qwen-2.5-coder-32b-instruct
#   meta-llama/llama-3.1-405b-instruct
#   meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# A site URL is recommended by OpenRouter for ranking on their free tier
SITE_URL=http://localhost:5173
SITE_NAME=Void Coder
